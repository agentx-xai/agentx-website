server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    resolver ${AGENTX_DNS_RESOLVER} valid=10s ipv6=off;

    server_tokens off;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src ${AGENTX_CSP_CONNECT_SRC}; font-src 'self'; form-action 'self' https:; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self'" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;

    location = /_healthz {
        access_log off;
        return 204;
    }

    location /v1/ {
        set $agentx_api_upstream ${AGENTX_API_UPSTREAM};
        proxy_pass $agentx_api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $http_x_request_id;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
    }

    location = /index.html {
        expires -1;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
